# Скопируй в .env и заполни значения (для локального запуска).
# На Railway добавляй переменные через UI: Project → Variables.
# В коммит реальные токены НЕ кладём — GitHub Secret Scanning блокирует push.

TG_BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

XAI_API_KEY=PUT_YOUR_XAI_API_KEY_HERE
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEMPERATURE=0.95
XAI_MAX_TOKENS=500

# Имена/алиасы, на которые бот реагирует в групповых чатах
BOT_NAME_ALIASES=ярик,ярослав,вомит,вомитбой,вомитбойчик,vomit,vomitboy,v0mitboy

# Размер истории диалога, которую бот помнит (число сообщений)
HISTORY_SIZE=100
# Макс. длина одной реплики в истории (символов), чтобы не переполнить контекст
HISTORY_MAX_CHARS=700

# Шанс «спонтанно вписаться» в групповой чат без упоминания (0..1)
GROUP_REPLY_CHANCE=0.05

# Таймаут запросов к xAI, секунд
REQUEST_TIMEOUT=60

# Веб-поиск для фактических вопросов (xAI web_search + fallback DuckDuckGo)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_TOKENS=700
SEARCH_TIMEOUT=120

# Порт для healthcheck (Railway сам подставит свой PORT)
PORT=8080

LOG_LEVEL=INFO
